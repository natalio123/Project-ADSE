# Catatan: Docker --env-file TIDAK mendukung komentar di akhir baris. Komentar hanya boleh di baris sendiri.

MODEL_PATH=/app/models/best_pilot_v2.pt

# Free tier: 640 jauh lebih cepat dari 960
IMGSZ=640
CONF=0.25

# Domain Vercel Anda (pisahkan dengan koma jika lebih dari satu)
ALLOWED_ORIGINS=https://ricawatch.vercel.app

# Opsional, untuk URL preview Vercel. Contoh: https://ricawatch-.*\.vercel\.app
ORIGIN_REGEX=

RATE_PER_MIN=300

# Biarkan kosong (kunci di browser tidak rahasia)
API_KEY=
